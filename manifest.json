{
  "manifest_version": 3,
  "name": "POE Trade Alert Auto-Clicker",
  "version": "1.1.0",
  "description": "Monitors Path of Exile trade alerts and auto-clicks 'Travel to hideout' button with user confirmation",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.pathofexile.com/*",
    "file:///*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "PoeLogo.png"
      ],
      "matches": [
        "https://www.pathofexile.com/*",
        "file:///*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "PoeLogo.png",
      "48": "PoeLogo.png",
      "128": "PoeLogo.png"
    }
  },
  "icons": {
    "16": "PoeLogo.png",
    "48": "PoeLogo.png",
    "128": "PoeLogo.png"
  }
}
